[Unit]
Description=MKCyberLabs sequential coding nightshift %i (disabled until approved)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/agent-orchestration-lab
ExecStart=/usr/bin/python3 %h/agent-orchestration-lab/scripts/nightshift.py run --config %h/.config/mk-nightshift/%i.json
TimeoutStartSec=7500
NoNewPrivileges=true
UMask=0077
